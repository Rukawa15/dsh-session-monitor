{
  "name": "dsh-session-monitor",
  "version": "0.6.2",
  "type": "module",
  "engines": {
    "dsh": ">=0.2.1-rc.5"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SKILL.md",
    "README.md",
    "skills/",
    "scripts/",
    "!scripts/__pycache__",
    "requirements.txt"
  ],
  "description": "Read-only monitor for local DeepSeek Harness (DSH) sessions: live task board, per-session tails, blocking reply wait, Markdown export, and optional IM push via dsh-im",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "session-monitor",
    "dashboard",
    "agent"
  ],
  "license": "MIT",
  "author": "Gucong Qian <Rukawa15>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Rukawa15/dsh-session-monitor.git"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
