{
  "name": "@local/dsh-session-monitor",
  "version": "0.5.2",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "SKILL.md",
    "README.md",
    "skills/",
    "scripts/",
    "requirements.txt"
  ],
  "description": "DSH 会话监视器: 实时会话状态、固定格式任务看板、跨会话信使与设置页参数配置",
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": []
    }
  }
}
